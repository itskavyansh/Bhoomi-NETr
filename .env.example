# =============================================================================
# Bhoomi-NETr — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# This file IS safe to commit to git (contains no real secrets).
# =============================================================================

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SECRET_KEY=<your-secret-key>

# SMS Alert Configuration (Fast2SMS Dev API - Quick SMS Route)
FAST2SMS_API_KEY=<your-fast2sms-dev-api-key>
ALERT_PHONE_NUMBER=<your-10-digit-mobile-number>
ALERT_COOLDOWN_MINUTES=15
SMS_ALERTS_ENABLED=true
