{
    "name": "bhoomi-netr",
    "version": "1.0.0",
    "description": "Mine subsidence monitoring — backend simulation and tooling",
    "type": "module",
    "private": true,
    "scripts": {
        "simulate": "node simulator.js",
        "simulate:tilt": "node simulator.js --scenario=excessive_tilt",
        "simulate:vibration": "node simulator.js --scenario=high_vibration",
        "simulate:critical": "node simulator.js --scenario=critical",
        "verify": "node verify_db.js",
        "test": "node test_function.js",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.115.0",
        "lucide-react": "^1.41.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.18.3",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@tailwindcss/vite": "^4.1.12",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.33.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.39.1",
        "vite": "^7.1.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}